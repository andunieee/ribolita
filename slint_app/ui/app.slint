import { StateViewer } from "views/state_viewer.slint";
import { NewEntry } from "views/new_entry.slint";
import { Entries } from "views/entries.slint";
import { Config } from "views/config.slint";
import { EntrySummary, KeyValue } from "components/entry_edit.slint";

export { EntrySummary, KeyValue }

export component AppWindow inherits Window {
    min-width: 360px;
    min-height: 560px;
    title: root.app_title;
    default-font-family: "Noto Sans";

    in-out property <string> app_title;

    property <int> active_tab;

    in-out property <string> state_path;
    in property <string> state_json;
    in property <string> state_error;

    in property <[string]> kind_names;

    in-out property <string> new_entry_kind;
    in-out property <string> new_entry_when;
    in-out property <[KeyValue]> new_entry_values;
    in property <string> new_entry_error;

    in property <[EntrySummary]> entries;
    in property <string> entries_error;
    in property <int> selected_entry_index: -1;
    in-out property <string> entry_kind;
    in-out property <string> entry_when;
    in-out property <[KeyValue]> entry_values;
    in property <string> entry_editor_error;

    in property <string> data_dir;
    in property <string> node_id;
    in property <string> program_id;
    in-out property <string> peer_connect_input;
    in-out property <string> peer_token_input;
    in property <[string]> connected_peers;

    callback refresh_state();
    callback new_entry_kind_selected(string);
    callback add_new_entry_row();
    callback remove_new_entry_row(int);
    callback submit_new_entry();
    callback refresh_entries();
    callback select_entry(int);
    callback entry_kind_selected(string);
    callback add_entry_row();
    callback remove_entry_row(int);
    callback save_entry();
    callback delete_entry();
    callback connect_peer();

    Rectangle {
        background: @linear-gradient(180deg, #f7f3ee 0%, #ebe5dd 100%);
        VerticalLayout {
            padding: 8px;
            spacing: 16px;

            Rectangle {
                background: #fefcf9;
                border-width: 1px;
                border-color: #d6cfc4;
                border-radius: 12px;
                HorizontalLayout {
                    padding: 8px;
                    spacing: 10px;
                    for tab[i] in ["State", "New Entry", "Entries", "Config"]: Rectangle {
                        horizontal-stretch: 1;
                        background: root.active_tab == i ? #e0d6c8 : transparent;
                        border-radius: 8px;
                        Text {
                            text: tab;
                            font-size: 13px;
                            color: root.active_tab == i ? #262421 : #5a554f;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        TouchArea {
                            clicked => {
                                root.active_tab = i;
                            }
                        }
                    }
                }
            }

            Flickable {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 14px;

                    if (root.active_tab == 0): StateViewer {
                        path <=> root.state_path;
                        json: root.state_json;
                        error: root.state_error;
                        refresh_state => root.refresh_state();
                    }

                    if (root.active_tab == 1): NewEntry {
                        kinds: root.kind_names;
                        error: root.new_entry_error;
                        kind <=> root.new_entry_kind;
                        when <=> root.new_entry_when;
                        values <=> root.new_entry_values;
                        kind_selected(k) => root.new_entry_kind_selected(k);
                        add_row => root.add_new_entry_row();
                        remove_row(i) => root.remove_new_entry_row(i);
                        submit => root.submit_new_entry();
                    }

                    if (root.active_tab == 2): Entries {
                        entries: root.entries;
                        error: root.entries_error;
                        selected_index: root.selected_entry_index;
                        kinds: root.kind_names;
                        edit_error: root.entry_editor_error;
                        edit_kind <=> root.entry_kind;
                        edit_when <=> root.entry_when;
                        edit_values <=> root.entry_values;
                        refresh => root.refresh_entries();
                        select(i) => root.select_entry(i);
                        kind_selected(k) => root.entry_kind_selected(k);
                        add_row => root.add_entry_row();
                        remove_row(i) => root.remove_entry_row(i);
                        save => root.save_entry();
                        delete => root.delete_entry();
                    }

                    if (root.active_tab == 3): Config {
                        data_dir: root.data_dir;
                        node_id: root.node_id;
                        program_id: root.program_id;
                        peer_connect_input <=> root.peer_connect_input;
                        peer_token_input <=> root.peer_token_input;
                        connected_peers: root.connected_peers;
                        connect_peer => root.connect_peer();
                    }
                }
            }
        }
    }
}
