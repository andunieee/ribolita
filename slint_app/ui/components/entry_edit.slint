import { Card } from "card.slint";
import {
    ComboBox,
    LineEdit,
    Button,
    DatePickerPopup,
    TimePickerPopup,
    Date,
} from "std-widgets.slint";

export struct KeyValue {
    key: string,
    value: string,
}

export struct EntrySummary {
    author: string,
    when: string,
    kind: string,
}

// Edits the kind, timestamp and values of an entry. The values model is owned by Rust: rows are
// edited in place, adding and removing rows goes through callbacks.
export component EntryEdit inherits VerticalLayout {
    in property <[string]> kinds;
    in property <string> submit_label: "Submit Entry";
    in property <string> error;
    in-out property <string> kind;
    // "YYYY-MM-DD HH:MM" in UTC, empty means now
    in-out property <string> when;
    in-out property <[KeyValue]> values;

    callback kind_selected(string);
    callback add_row();
    callback remove_row(int);
    callback submit();

    property <Date> picked_date;

    spacing: 10px;
    if (root.kinds.length > 0): ComboBox {
        model: root.kinds;
        current-value: root.kind;
        horizontal-stretch: 1;
        selected(text) => {
            root.kind = text;
            root.kind_selected(text);
        }
    }
    if (root.kinds.length == 0): LineEdit {
        text <=> root.kind;
        placeholder-text: "Kind";
        horizontal-stretch: 1;
    }

    HorizontalLayout {
        spacing: 8px;
        Button {
            horizontal-stretch: 1;
            text: root.when == "" ? "When: now" : "When: " + root.when + " UTC";
            clicked => {
                date-picker.show();
            }
        }

        if (root.when != ""): Button {
            text: "Now";
            clicked => {
                root.when = "";
            }
        }
    }

    date-picker := DatePickerPopup {
        close-policy: PopupClosePolicy.no-auto-close;
        title: "Event Date";

        accepted(date) => {
            root.picked_date = date;
            date-picker.close();
            time-picker.show();
        }
        canceled => {
            date-picker.close();
        }
    }

    time-picker := TimePickerPopup {
        title: "Event Time";

        accepted(time) => {
            root.when = root.picked_date.year + "-" + root.picked_date.month + "-" + root.picked_date.day + " " + time.hour + ":" + time.minute;
            time-picker.close();
        }

        canceled => {
            time-picker.close();
        }
    }

    Rectangle {
        background: #f7f3ee;
        border-width: 1px;
        border-color: #d6cfc4;
        border-radius: 10px;
        VerticalLayout {
            padding: 10px;
            spacing: 8px;
            for row[i] in root.values: HorizontalLayout {
                spacing: 8px;
                LineEdit {
                    text: row.key;
                    placeholder-text: "key";
                    horizontal-stretch: 1;
                    edited(text) => {
                        root.values[i].key = text;
                    }
                }

                LineEdit {
                    text: row.value;
                    placeholder-text: "value";
                    horizontal-stretch: 1;
                    edited(text) => {
                        root.values[i].value = text;
                    }
                }

                Button {
                    text: "Remove";
                    clicked => {
                        root.remove_row(i);
                    }
                }
            }

            Button {
                text: "Add Field";
                clicked => {
                    root.add_row();
                }
            }
        }
    }

    if (root.error != ""): Text {
        text: root.error;
        color: #8d3434;
        font-size: 12px;
        wrap: word-wrap;
    }
    Button {
        text: root.submit_label;
        clicked => {
            root.submit();
        }
    }
}
